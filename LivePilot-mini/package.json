{
  "name": "streamlabs-rounds-mini",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ignore-pattern .next --ignore-pattern data --ignore-pattern work",
    "db:generate": "prisma generate",
    "db:migrate": "node scripts/init-db.mjs",
    "db:migrate:dev": "prisma migrate dev",
    "db:studio": "prisma studio",
    "test:integration": "node scripts/integration-test.mjs",
    "test:chat": "node --test scripts/chat-readiness-test.mjs",
    "test:limits": "node --test scripts/session-limits-test.mjs",
    "test:retries": "node --test scripts/retry-controller-test.mjs",
    "test:streamlabs": "node --test scripts/streamlabs-test.mjs",
    "test:bank": "tsx --test scripts/bank-ledger-test.mjs",
    "test:browser": "node scripts/browser-smoke-test.mjs"
  },
  "dependencies": {
    "@prisma/client": "6.12.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.1.0",
    "lucide-react": "0.468.0",
    "next": "16.3.3",
    "next-themes": "0.4.6",
    "playwright": "1.62.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "2.6.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.3",
    "prisma": "6.12.0",
    "tailwindcss": "4.2.1",
    "tsx": "^4.20.6",
    "typescript": "5.9.3"
  }
}
